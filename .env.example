# Public env for the Deal Screen pilot (Next.js inlines NEXT_PUBLIC_* at build time).
#
# Pilot feedback — Google Forms pre-filled *responder* link (not the editor URL).
# Create the form, use “Get pre-filled link”, then paste the full viewform URL here.
# Leave unset or keep the placeholder until the form is ready; the Home page then
# shows an email fallback instead of a broken primary button.
NEXT_PUBLIC_PILOT_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_PREFILLED_FORM_URL/viewform
